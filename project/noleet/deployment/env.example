# NoLeet Production Environment Configuration
# Copy this file to .env and update with your actual values

# Application Configuration
NOLEET_ENV=production
NOLEET_LOG_LEVEL=INFO
NOLEET_AUTO_OPTIMIZE=true

# Domain Configuration
DOMAIN=api.noleet.ai
MONITORING_DOMAIN=monitoring.noleet.ai

# Database Configuration
POSTGRES_PASSWORD=your-secure-postgres-password
DATABASE_URL=postgresql://noleet:${POSTGRES_PASSWORD}@noleet-postgresql:5432/noleet

# Redis Configuration
REDIS_PASSWORD=your-secure-redis-password
REDIS_URL=redis://:${REDIS_PASSWORD}@noleet-redis:6379/0

# Security Configuration
SECRET_KEY=your-256-bit-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here
CORS_ORIGINS=https://noleet.ai,https://app.noleet.ai

# LLM API Keys
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
TOGETHER_API_KEY=your-together-api-key
GEMINI_API_KEY=your-gemini-api-key

# External Service Configuration
LEETCODE_SESSION_COOKIE=your-leetcode-session-cookie
GITHUB_TOKEN=your-github-personal-access-token

# Monitoring Configuration
GRAFANA_PASSWORD=your-secure-grafana-password

# Email Configuration (for alerts)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=noleet-alerts@noleet.ai
SMTP_PASSWORD=your-smtp-app-password

# Slack Integration (for alerts)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Docker Configuration
DOCKER_REGISTRY=docker.io/noleet
DOCKER_TAG=latest

# Kubernetes Configuration
KUBERNETES_NAMESPACE=noleet
STORAGE_CLASS=standard

# SSL/TLS Configuration (for cert-manager)
CERT_ISSUER_EMAIL=admin@noleet.ai
CERT_ISSUER_SERVER=https://acme-v02.api.letsencrypt.org/directory

# Backup Configuration
BACKUP_S3_BUCKET=noleet-backups
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# Performance Tuning
GUNICORN_WORKERS=4
GUNICORN_WORKER_CONNECTIONS=1000
CACHE_MAX_SIZE=10000
LLM_CACHE_TTL=3600

# Feature Flags
ENABLE_ADVANCED_ANALYTICS=true
ENABLE_REAL_TIME_COLLABORATION=true
ENABLE_AI_INSIGHTS=true
ENABLE_PERSONALIZATION=true

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST_SIZE=20

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3
HEALTH_CHECK_INTERVAL=30
