        """Parse HTML content using BeautifulSoup if available."""
        try:
            from bs4 import BeautifulSoup
            return BeautifulSoup(html_content, 'html.parser')
        except ImportError:
            # Fallback: return raw content and disable advanced selectors
            return html_content

