        output_field: str = "extracted_data",
        rules_field: str = "extraction_rules"
    ):
        """Initialize configurable HTML parser stage.

        Args:
            name: Stage name
            default_rules: Default extraction rules if none provided in data
            input_field: Field containing HTML content
            output_field: Field for extracted data
            rules_field: Field containing extraction rules configuration
        """
        super().__init__(name)
        self.default_rules = default_rules or []
        self.input_field = input_field
